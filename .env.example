# Wave Team Pro — environment variables
# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are bundled into the browser; everything else is server-only.

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co (local CLI: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key (safe to expose: RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key. SERVER ONLY. Bypasses RLS. Used for auth admin (invite, ban),
# avatar writes after server-side processing, and the rate limiter.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
# Public base URL of this deployment (no trailing slash). Must also be the Supabase Auth Site URL.
APP_BASE_URL=http://localhost:3000
# Random string (>= 32 chars) used to hash rate-limit keys. Required in production.
# Generate: openssl rand -hex 32
RATE_LIMIT_SALT=

# --- Receipt reading (optional) ----------------------------------------------
# "anthropic" or "openai" turns on automatic receipt reading. Leave empty for manual entry only.
# The key is server-only; receipts are sent to this provider (users see a disclosure).
AI_PROVIDER=
AI_API_KEY=
# Vision-capable model id from your provider's documentation.
AI_MODEL=
# Optional: OpenAI-compatible or proxy base URL (no trailing slash).
AI_BASE_URL=

# --- Later phases ----------------------------------------------------------
# Transactional email beyond Supabase Auth emails (Phase B notifications)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Wave Team Pro <no-reply@example.com>"
# Web push (Phase B)
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Error monitoring (optional)
SENTRY_DSN=

# --- Email (invitations, management notifications, weekly timesheets) ------
# Resend (resend.com) API key and a verified sender, e.g. "Your Company <team@yourcompany.com>".
# Without these, invitations fall back to Supabase's limited built-in emails plus "Copy link".
# (EMAIL_PROVIDER_API_KEY / EMAIL_FROM above are the same variables.)

# --- Scheduled jobs ----------------------------------------------------------
# Random string; Vercel sends it to /api/cron/weekly-timesheets every Monday 06:00 UTC.
CRON_SECRET=

# Microsoft 365 / SharePoint filing (app registration with Sites.Selected, write access to one site)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
